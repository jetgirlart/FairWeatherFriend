    default:
      return "UNKNOWN";
  }
}

// ==================================================
// MOON PHASE
// ==================================================

MoonPhase calculateMoonPhase() {

  if (!timeValid) {
    return MOON_NEW;
  }

  // Known new moon near Jan 6, 2000.
  const time_t knownNewMoon = 947182440;

  const double lunarCycle =
    29.530588853;

  time_t now =
    time(nullptr);

  double daysSince =
    difftime(now, knownNewMoon) /
    86400.0;

  double moonAge =
    fmod(daysSince, lunarCycle);

  if (moonAge < 0) {
    moonAge += lunarCycle;
  }

  int phase =
    (int)floor(
      (moonAge / lunarCycle) *
      8.0 +
      0.5
    ) % 8;

  return (MoonPhase)phase;
}

