        SH110X_WHITE
      );

      display.drawLine(
        x + 7, y + 7,
        x + 5, y + 11,
        SH110X_WHITE
      );

      break;

    case WEATHER_SNOW:

      drawCloud(
        x - 8,
        y - 2
      );

      display.drawPixel(
        x - 5,
        y + 9,
        SH110X_WHITE
      );

      display.drawPixel(
        x + 1,
        y + 11,
        SH110X_WHITE
      );

      display.drawPixel(
        x + 7,
        y + 9,
        SH110X_WHITE
      );

      break;

    case WEATHER_STORM:

      drawCloud(
        x - 8,
        y - 3
      );

      display.drawLine(
        x,
        y + 5,
        x - 4,
        y + 12,
        SH110X_WHITE
      );

      display.drawLine(
        x - 4,
        y + 12,
        x + 1,
        y + 12,
        SH110X_WHITE
      );

      display.drawLine(
        x + 1,
        y + 12,
        x - 3,
        y + 18,
        SH110X_WHITE
      );

      break;

    case WEATHER_FOG:

      display.drawLine(
        x - 10, y - 5,
        x + 10, y - 5,
        SH110X_WHITE
      );

      display.drawLine(
        x - 7, y,
